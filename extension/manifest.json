{
  "manifest_version": 3,
  "name": "Kage 影读 · YouTube 日语影子跟读",
  "short_name": "Kage 影读",
  "version": "0.2.0",
  "description": "把任意 YouTube 日语视频变成影子跟读教材：逐句循环、自动停顿、录音对比、注音查词、生词本与 AI 语法拆解。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://jisho.org/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 Kage 影读"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "打开 Kage 影读侧边栏"
    }
  }
}
